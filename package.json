{
  "name": "paper-flight-lab",
  "version": "1.0.0",
  "private": true,
  "license": "BlueOak-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:slow": "node --import tsx --test --test-concurrency=2 tests/slow/*.test.ts",
    "test:full": "node --import tsx --test --test-concurrency=2 tests/slow/*.test.ts tests/*.test.ts",
    "test:browser-ui": "node tests/browser-ui.mjs",
    "benchmark": "node --import tsx tests/benchmark.ts",
    "benchmark:physics": "node --import tsx tests/physics-benchmark.ts",
    "benchmark:launcher": "node --import tsx tests/launcher-benchmark.ts",
    "benchmark:contact": "node --import tsx tests/self-contact-benchmark.ts",
    "benchmark:performance": "node --import tsx tests/performance-benchmark.ts",
    "benchmark:realtime": "node --import tsx tests/realtime-benchmark.ts",
    "benchmark:compare": "node --import tsx tests/compare-performance.ts",
    "benchmark:browser": "node tests/browser-performance.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "tsx": "^4.20.6",
    "@types/node": "^24.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
